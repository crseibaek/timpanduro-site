---
import Base from '../layouts/Base.astro';
import Gallery from './Gallery.astro';
import Lightbox from './Lightbox.astro';
import site from '../data/site.json';
import { getProductions, toCard, resolveThumbnails } from '../lib/catalogue';
import type { CollectionEntry } from 'astro:content';

interface Props {
  offer: CollectionEntry<'offers'>;
}
const { offer } = Astro.props;
const d = offer.data;

const all = await getProductions();
const byId = new Map(all.map((p) => [p.id, p]));
// Keep the order the CMS gave them, drop anything that no longer exists.
const chosen = d.productions.map((id) => byId.get(id)).filter(Boolean) as typeof all;
const thumbs = await resolveThumbnails(chosen);
const cards = chosen.map((p) => toCard(p, thumbs));

const headline = d.headline?.trim() || 'A few films worth seeing';
const paras = d.intro.split(/\n{2,}/).filter(Boolean);
const outro = d.outro?.trim();

const dateStr = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(d.date);

const subject = encodeURIComponent(`Re: ${headline}`);
---

<Base title={`${site.name} — ${d.customer}`} noindex={true}>
  <div class="wrap">
    <section class="offer-head">
      <span class="label to">For {d.customer}</span>
      <h1 class="display">{headline}</h1>
    </section>

    <section class="offer-body">
      <div class="offer-note">
        {paras.map((p) => <p>{p}</p>)}
        <div class="offer-cta">
          <a class="btn" href={`mailto:${site.email}?subject=${subject}`}>Get in touch</a>
          {site.phone && (
            <a class="btn ghost" href={`tel:${site.phone.replace(/\s/g, '')}`}>Call me</a>
          )}
        </div>
      </div>

      <aside>
        <div style="font-weight:500">{site.name}</div>
        <div class="contact-list" style="margin-top:1.25rem;padding-top:1.25rem">
          <span><a href={`mailto:${site.email}`}>{site.email}</a></span>
          {site.phone && <span><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></span>}
          <span class="label" style="margin-top:0.6rem">Written {dateStr}</span>
        </div>
      </aside>
    </section>

    <section>
      <p class="label" style="margin-bottom:1rem">
        Selected films — {cards.length}
      </p>
      <Gallery cards={cards} variant="offer" />
    </section>

    {outro && (
      <section style="padding-bottom:1rem">
        <p class="lede">{outro}</p>
      </section>
    )}

    <section class="offer-foot">
      <span>{site.name} · {site.email}</span>
      <a class="btn ghost" href="/">See the full portfolio</a>
    </section>
  </div>

  <Lightbox />

  <script is:inline define:vars={{ slug: offer.id, customer: d.customer }}>
    // Fire-and-forget open tracking. Fails silently when the function is not
    // deployed (e.g. local `astro dev`), and never blocks the page.
    try {
      const key = 'seen:' + slug;
      const body = JSON.stringify({
        slug,
        customer,
        ref: document.referrer || '',
        repeat: !!sessionStorage.getItem(key),
      });
      sessionStorage.setItem(key, '1');
      if (navigator.sendBeacon) {
        navigator.sendBeacon('/api/track', new Blob([body], { type: 'application/json' }));
      } else {
        fetch('/api/track', { method: 'POST', body, keepalive: true }).catch(() => {});
      }
    } catch (e) {
      /* tracking is never load-bearing */
    }
  </script>
</Base>
