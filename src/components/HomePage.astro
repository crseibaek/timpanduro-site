---
import Base from '../layouts/Base.astro';
import Gallery from './Gallery.astro';
import Lightbox from './Lightbox.astro';
import site from '../data/site.json';
import { getProductions, toCard, resolveThumbnails } from '../lib/catalogue';

const productions = await getProductions();
const thumbs = await resolveThumbnails(productions);
const cards = productions.map((p) => toCard(p, thumbs));
---

<Base
  title={site.name}
  description={`Films by ${site.name}: stage, cinema, documentary and commercial.`}
  filters={true}
>
  <div class="wrap">
    <h1 class="sr-only">{site.name}</h1>
    <Gallery cards={cards} />
    <p class="wall-empty" data-wall-empty hidden>Nothing in this category yet.</p>
  </div>

  <Lightbox />
</Base>
