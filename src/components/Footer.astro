---
import site from '../data/site.json';

const year = 2026;
const social = [
  { label: 'Vimeo', href: site.vimeo },
  { label: 'Instagram', href: site.instagram },
  { label: 'LinkedIn', href: site.linkedin },
  // A bare "https://vimeo.com/" is the empty default, not a profile.
].filter((s) => s.href && !/^https?:\/\/(www\.)?[^/]+\/?$/.test(s.href));
---

<footer class="site-footer">
  <div class="wrap inner">
    <span>© {year} {site.name}{site.cvr ? ` · CVR ${site.cvr}` : ''}</span>
    <span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      {site.phone && <span> · {site.phone}</span>}
      {social.map((s) => <span> · <a href={s.href} rel="noopener">{s.label}</a></span>)}
    </span>
  </div>
</footer>
